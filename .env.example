# 复制为 .env 或直接 export 后使用。所有变量均可选，未配置时使用默认值。

# ---- 脚本生成（OpenAI 兼容 Chat Completions 接口）----
# auto: 有 SCRIPT_API_KEY 时调用大模型，否则使用内置离线模板
SCRIPT_PROVIDER=auto
SCRIPT_API_KEY=
SCRIPT_BASE_URL=https://api.openai.com/v1
SCRIPT_MODEL=gpt-4o-mini
SCRIPT_TARGET_DURATION=45

# ---- 配音（edge 免费无需密钥；openai 兼容 /audio/speech；silent 静音占位）----
TTS_PROVIDER=edge
# edge 使用 zh-CN-XiaoxiaoNeural 等中文音色；openai 时改为 alloy/nova 等
TTS_VOICE=zh-CN-XiaoxiaoNeural
TTS_RATE=1.0
TTS_API_KEY=
TTS_BASE_URL=https://api.openai.com/v1
TTS_MODEL=tts-1
# 配音失败时的行为：silent（继续出片并告警）或 error（中断任务）
TTS_FALLBACK=silent

# ---- 通用 ----
# OPENAI_API_KEY=
# VIDEO_AGENT_OUTPUT_DIR=./output
# VIDEO_AGENT_LIBRARY_DIR=./materials
# VIDEO_WIDTH=1080
# VIDEO_HEIGHT=1920
# VIDEO_FPS=30
# PORT=8787
# FFMPEG_PATH=
# FFPROBE_PATH=
# ---- AI 画面生成（通用 HTTP 文生视频接口，provider=http 时启用）----
# 接口契约见 README；不绑定具体厂商，可用自建网关适配
VIDEOGEN_PROVIDER=none
VIDEOGEN_BASE_URL=
VIDEOGEN_MODEL=video-gen-1
VIDEOGEN_API_KEY=
VIDEOGEN_SUBMIT_PATH=/v1/videos/generations
VIDEOGEN_POLL_PATH=/v1/videos/generations/{id}

# ---- 抖音开放平台（OAuth 授权与发布）----
DOUYIN_CLIENT_KEY=
DOUYIN_CLIENT_SECRET=
# 留空时使用 http://<host>:<port>/api/douyin/callback
DOUYIN_REDIRECT_URI=
DOUYIN_SCOPE=user_info,video.create
DOUYIN_API_BASE_URL=https://open.douyin.com

# ---- 网页设置 ----
# 默认 ./data/settings.json；网页设置优先级高于环境变量
# VIDEO_AGENT_SETTINGS_FILE=./data/settings.json
